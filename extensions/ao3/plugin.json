{
  "metadata": {
    "name": "Archive of Our Own",
    "author": "Ivy",
    "version": 3,
    "source": "https://archiveofourown.org",
    "regexp": "(https?://)?(www\\.)?(archiveofourown\\.(org|com|net|gay)|ao3\\.org)/(works|chapters)/\\d+.*",
    "description": "Đọc fanfiction trên Archive of Our Own (AO3)",
    "locale": "en",
    "language": "javascript",
    "type": "novel",
    "nsfw": false
  },
  "script": {
    "home": "home.js",
    "genre": "genre.js",
    "search": "search.js",
    "detail": "detail.js",
    "toc": "toc.js",
    "chap": "chap.js"
  },
  "config": {
    "DOMAIN": {
      "title": "Domain",
      "default": "https://archiveofourown.org",
      "mode": "input",
      "format": "text"
    },
    "SHOW_NOTES": {
      "title": "Hiện ghi chú tác giả",
      "subtitle": "Hiện Summary/Notes của từng chương trong nội dung",
      "default": "true",
      "mode": "toggle"
    },
    "thread_num": 2,
    "delay": 1000
  }
}
